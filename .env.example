# Copia este archivo a .env y completa los valores en tu entorno local.
# No subas .env ni credenciales reales al repositorio.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_CLAVE_ANON_O_PUBLISHABLE

# Solo para scripts administrativos del servidor. Nunca exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CAMBIAR_POR_UNA_CLAVE_SEGURA
ADMIN_NAME=Administrador
ADMIN_JOB_TITLE=Administrador

# Solo para crear cuentas de prueba en un proyecto de desarrollo.
# Usa correos que controles y contraseñas únicas de al menos 12 caracteres.
TEST_ADMIN_NAME=Administrador de prueba
TEST_ADMIN_EMAIL=admin-test@example.com
TEST_ADMIN_PASSWORD=CAMBIAR_POR_UNA_CLAVE_SEGURA_DE_PRUEBA
TEST_VET_NAME=Veterinario de prueba
TEST_VET_EMAIL=veterinario-test@example.com
TEST_VET_PASSWORD=CAMBIAR_POR_UNA_CLAVE_SEGURA_DE_PRUEBA
TEST_RECEPCION_NAME=Recepcionista de prueba
TEST_RECEPCION_EMAIL=recepcion-test@example.com
TEST_RECEPCION_PASSWORD=CAMBIAR_POR_UNA_CLAVE_SEGURA_DE_PRUEBA
